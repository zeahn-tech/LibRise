# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Application Environment Configuration
VITE_APP_ENV="development"
VITE_API_BASE_URL="/api"
VITE_DEFAULT_CURRENCY="USD"
VITE_ENABLE_LOW_BANDWIDTH_MODE="false"
VITE_PWA_ENABLED="true"

# Supabase Backend Configuration
# Obtain these from your Supabase Project Dashboard under Project Settings -> API
# 1. Project URL (Public)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
# 2. Public Anon Key (Client-Safe, respect RLS policies)
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
# 3. Service Role Secret Key (SERVER-SIDE ONLY - NEVER expose to frontend or prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=
# server.ts (a plain Node/Express process, not a Vite client bundle) reads
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY above directly via process.env
# (dotenv loads the whole file regardless of the VITE_ prefix) to verify
# real browser-issued JWTs with supabase.auth.getUser(token). It never uses
# the service-role key above for this -- only the anon key, same as the client.

# Opt-in local demo mode (client AND server). Defaults to false outside
# development/test (see src/config/env.ts). When true, a request whose
# token Supabase rejects falls back to the local dbClient session store
# ONLY for that explicit demo path -- never silently in a real deployment.
VITE_ENABLE_DEMO_MODE="false"

# Stripe Billing Configuration
# Secret key for server-side API calls
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public key for client-side Stripe Elements/Checkout
VITE_STRIPE_PUBLIC_KEY=
VITE_STRIPE_BASIC_MONTHLY_PRICE_ID=
VITE_STRIPE_BASIC_ANNUAL_PRICE_ID=
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=
VITE_STRIPE_PRO_ANNUAL_PRICE_ID=

# Manual mobile money payments (interim, pre-API-integration -- see
# docs/PAYMENTS.md). Real business MoMo numbers, not placeholders --
# leave empty until you actually have them; the UI shows "not yet
# configured" for an empty value rather than a fake-looking one.
VITE_MOMO_MTN_NUMBER=
VITE_MOMO_ORANGE_NUMBER=
VITE_MOMO_ACCOUNT_NAME=

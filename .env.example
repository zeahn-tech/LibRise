# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Production hosting: PORT is supplied by the host. TRUST_PROXY_HOPS (default 1) = proxies in front of the app.
# ALLOWED_ORIGINS: comma-separated site origins allowed to call this API, e.g. https://zeahn-tech.github.io
# ALLOWED_ORIGINS="https://zeahn-tech.github.io"
# Optional: override the Gemini model without a code change (default gemini-3.8-flash).
# GEMINI_MODEL="gemini-3.5-flash"
# Optional: per-account AI requests allowed per 15 minutes (default 40).
# AI_REQUESTS_PER_15_MIN=40

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Application Environment Configuration
VITE_APP_ENV="development"
VITE_API_BASE_URL="/api"
# Display currency default. Production should use LRD. If unset: LRD in production, USD elsewhere.
# This is DISPLAY only -- customers still choose LRD or USD separately when they pay.
VITE_DEFAULT_CURRENCY="USD"
VITE_ENABLE_LOW_BANDWIDTH_MODE="false"
VITE_PWA_ENABLED="true"

# Supabase Backend Configuration
# Obtain these from your Supabase Project Dashboard under Project Settings -> API
# 1. Project URL (Public)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
# 2. Public Anon Key (Client-Safe, respect RLS policies)
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
# 3. Service Role Secret Key (SERVER-SIDE ONLY - NEVER expose to frontend or prefix with VITE_)
# SERVER ONLY (Express backend). Used by /api/admin/auth-enforcement/sync. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# server.ts (a plain Node/Express process, not a Vite client bundle) reads
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY above directly via process.env
# (dotenv loads the whole file regardless of the VITE_ prefix) to verify
# real browser-issued JWTs with supabase.auth.getUser(token). It never uses
# the service-role key above for this -- only the anon key, same as the client.

# Opt-in local demo mode (client AND server). Defaults to false outside
# development/test (see src/config/env.ts). When true, a request whose
# token Supabase rejects falls back to the local dbClient session store
# ONLY for that explicit demo path -- never silently in a real deployment.
VITE_ENABLE_DEMO_MODE="false"

# Stripe Billing Configuration
# Secret key for server-side API calls
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public key for client-side Stripe Elements/Checkout
VITE_STRIPE_PUBLIC_KEY=
VITE_STRIPE_BASIC_MONTHLY_PRICE_ID=
VITE_STRIPE_BASIC_ANNUAL_PRICE_ID=
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=
VITE_STRIPE_PRO_ANNUAL_PRICE_ID=

# Manual mobile money payments (interim, pre-API-integration -- see
# docs/PAYMENTS.md). Real business MoMo numbers, not placeholders --
# leave empty until you actually have them; the UI shows "not yet
# configured" for an empty value rather than a fake-looking one.
VITE_MOMO_MTN_NUMBER=
VITE_MOMO_ORANGE_NUMBER=
VITE_MOMO_ACCOUNT_NAME=

# Dual-currency receiving accounts (all optional; see docs/PAYMENTS.md "Dual-currency payments").
# A mobile money number that can receive USD may NOT be able to receive LRD (and vice versa), so each
# network + currency can have its own account. The checkout shows "not set up yet" for any combination
# left empty -- it never shows a placeholder number.
#   * USD falls back to the legacy VITE_MOMO_MTN_NUMBER / VITE_MOMO_ORANGE_NUMBER above (backward compatible).
#   * LRD does NOT fall back to the legacy numbers unless VITE_MOMO_LEGACY_NUMBERS_ACCEPT_LRD=true.
# These are public by design (they are shown to payers); never put secrets in a VITE_ variable.
VITE_MOMO_MTN_NUMBER_USD=
VITE_MOMO_MTN_NUMBER_LRD=
VITE_MOMO_ORANGE_NUMBER_USD=
VITE_MOMO_ORANGE_NUMBER_LRD=
# Optional per-currency account-name overrides (fall back to VITE_MOMO_ACCOUNT_NAME).
VITE_MOMO_ACCOUNT_NAME_USD=
VITE_MOMO_ACCOUNT_NAME_LRD=
# Set to true ONLY if the legacy numbers really can receive LRD too.
VITE_MOMO_LEGACY_NUMBERS_ACCEPT_LRD=false
